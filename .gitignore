# Unreal Engine .gitignore
# Based on GitHub's standard UnrealEngine template

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.vcxproj.user
*.sln.docstates
*.suo
*.user
*.userprefs
*.opensdf
*.sdf
*.opendb

# Build files generated by Unreal Build Tool
*.xcodeproj
*.xcworkspace
Makefile
CMakeLists.txt
CMakeCache.txt

# Visual Studio solution (regenerated by UBT — comment out if you want to keep it)
# *.sln

# Compiled binaries
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
**/obj/

# Compiled C++ libraries / executables
*.dll
*.exe
*.lib
*.exp
*.pdb
*.idb
*.pdb
*.app
*.ipa
*.apk

# Unreal Engine specific
*.uasset.merge
*.umap.merge
*.ubt.csproj
*.ue4project
*.ue4projecttemplate
*.uprojectdirs

# Plugins' intermediate/build output (source stays tracked)
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Auto-saved / backup assets
Saved/Autosaves/
Saved/Backup/
*.uasset_autosave
*.umap_autosave

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Crash reports and logs
*.log
Saved/Crashes/
Saved/Logs/
